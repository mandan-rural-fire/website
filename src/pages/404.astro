---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page not found | Mandan Rural Fire"
  description="That page does not exist. Find fire danger info, board meetings, prevention tips, and how to join the Mandan Rural Fire Department."
>
  <div class="pagehead"><div class="wrap">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="lead">That page doesn't exist, or it moved. If you followed a link here, the pages below cover everything on the site.</p>
  </div></div>

  <section>
    <div class="wrap" style="max-width:620px;">
      <ul style="list-style:none;padding:0;margin:0;font-size:1.05rem;line-height:2.2;">
        <li><a href="/">Home, current fire danger</a></li>
        <li><a href="/district">District board, agendas &amp; minutes</a></li>
        <li><a href="/prevention">Fire prevention &amp; safety</a></li>
        <li><a href="/resources">Maps &amp; resources</a></li>
        <li><a href="/join">Become a volunteer</a></li>
      </ul>
      <p class="muted" style="margin-top:2rem;">For emergencies, always call <a href="tel:911"><strong>911</strong></a>.</p>
    </div>
  </section>
</Base>
