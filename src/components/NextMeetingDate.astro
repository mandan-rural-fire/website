---
import { nextMeetingDate, formatMeetingDate } from '../lib/content/schedule';

/**
 * The next meeting date as text. Server-rendered at build time so the page
 * works without JS, then recomputed on load, because static rebuilds only
 * happen on content changes and the baked-in date can go stale between them.
 */
interface Props {
  weekOfMonth: number;
  weekday: number;
}
const { weekOfMonth, weekday } = Astro.props;
const next = nextMeetingDate({ weekOfMonth, weekday });
---
<span class="nm-date" data-week-of-month={weekOfMonth} data-weekday={weekday}>{formatMeetingDate(next)}</span>

<script>
  import { nextMeetingDate, formatMeetingDate } from '../lib/content/schedule';

  // astro:page-load fires on first load and after every client-side swap.
  document.addEventListener('astro:page-load', () => {
    for (const el of document.querySelectorAll<HTMLElement>('.nm-date')) {
      const weekOfMonth = Number(el.dataset.weekOfMonth);
      const weekday = Number(el.dataset.weekday);
      if (!Number.isInteger(weekOfMonth) || !Number.isInteger(weekday)) continue;
      el.textContent = formatMeetingDate(nextMeetingDate({ weekOfMonth, weekday }));
    }
  });
</script>
